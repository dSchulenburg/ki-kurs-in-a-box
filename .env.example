# Optional. Ohne diese Datei laeuft die Box mit den Standardwerten, die in der
# docker-compose.yml stehen. Das ist fuer den lokalen Gebrauch genau richtig.
#
# Zum Aendern: diese Datei nach ".env" kopieren und Werte anpassen. Danach
# einmal "docker compose down -v && docker compose up -d", denn Passwoerter
# werden nur beim Erststart in die Datenbank geschrieben.

# --- Moodle ---------------------------------------------------------------
MOODLE_ADMIN_PASS=KiKurs-Demo-2026

# --- Datenbank ------------------------------------------------------------
DB_PASSWORD=ki-kurs-moodle
DB_ROOT_PASSWORD=ki-kurs-root

# --- Schnittstelle fuer die KI --------------------------------------------
# Der Token muss zu dem passen, der im Moodle-Image vorgebacken ist. Aenderst
# du ihn hier, musst du ihn auch in Moodle aendern (Website-Administration ->
# Server -> Webservices -> Tokens verwalten).
MOODLE_MCP_TOKEN=0ercamp2026werkbankdemotoken1234

# Schluessel, mit dem sich dein KI-Werkzeug am MCP anmeldet. Frei waehlbar,
# muss nur mit dem Wert in deiner .mcp.json uebereinstimmen.
MCP_API_KEY=ki-kurs-lokal
